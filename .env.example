# kaos-source Environment Variables
# Copy to .env and fill in required values.
# Only GOVINFO_API_KEY is required; all other connectors work without keys.

# ============================================================================
# GovInfo (Government Publishing Office)
# Required: API key from https://api.data.gov/signup/
# ============================================================================
KAOS_SOURCE_GOVINFO_API_KEY=
# GOVINFO_API_KEY=            # Legacy alias (backward compatible)
# KAOS_SOURCE_GOVINFO_TIMEOUT=30.0
# KAOS_SOURCE_GOVINFO_USER_AGENT=kaos-source/0.1 (https://273ventures.com)

# ============================================================================
# EDGAR (SEC filings)
# No API key needed. SEC requires descriptive User-Agent with company + email.
# ============================================================================
# KAOS_SOURCE_EDGAR_USER_AGENT=YourCompany contact@company.com
# KAOS_SOURCE_EDGAR_TIMEOUT=30.0

# ============================================================================
# Federal Register
# No API key needed. Public REST API.
# ============================================================================
# KAOS_SOURCE_FR_TIMEOUT=30.0
# KAOS_SOURCE_FR_CONTENT_TIMEOUT=120.0
# KAOS_SOURCE_FR_USER_AGENT=kaos-source/0.1 (https://273ventures.com)

# ============================================================================
# eCFR (Code of Federal Regulations)
# No API key needed. Public REST API.
# ============================================================================
# KAOS_SOURCE_ECFR_TIMEOUT=30.0
# KAOS_SOURCE_ECFR_CONTENT_TIMEOUT=300.0
# KAOS_SOURCE_ECFR_USER_AGENT=kaos-source/0.1 (https://273ventures.com)

# ============================================================================
# HTTP Connector (generic URL fetching)
# ============================================================================
# KAOS_SOURCE_HTTP_TIMEOUT_SECONDS=30.0
# KAOS_SOURCE_HTTP_RETRY_LIMIT=2
# KAOS_SOURCE_HTTP_USER_AGENT=kaos-source/0.1
# KAOS_SOURCE_HTTP_VERIFY_SSL=true
# KAOS_SOURCE_HTTP_FOLLOW_REDIRECTS=true
# KAOS_SOURCE_HTTP_HTTP2=false

# ============================================================================
# Browser Connector (Playwright, requires [browser] extra)
# ============================================================================
# KAOS_SOURCE_BROWSER_HEADLESS=true
# KAOS_SOURCE_BROWSER_TIMEOUT_MS=30000
# KAOS_SOURCE_BROWSER_WAIT_UNTIL=networkidle

# ============================================================================
# kaos-web Search Backends (used by kaos-web, not kaos-source)
# ============================================================================
# KAOS_WEB_SERPAPI_API_KEY=
# SERPAPI_API_KEY=             # Legacy alias
# KAOS_WEB_EXA_API_KEY=
# EXA_API_KEY=                 # Legacy alias
# KAOS_WEB_BRAVE_API_KEY=
# BRAVE_API_KEY=               # Legacy alias
